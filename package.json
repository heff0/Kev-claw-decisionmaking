{
  "name": "openclaw-d1-local",
  "version": "0.2.0",
  "type": "module",
  "description": "Runs typed decisions locally on Apple Silicon: your OpenClaw agent queries a LiquidAI d1-Omni model over loopback - no cloud API, no per-token bill, private state stays on your machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heff0/Kev-claw-decisionmaking.git"
  },
  "homepage": "https://github.com/heff0/Kev-claw-decisionmaking",
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "launchd/",
    "config/model.env.example",
    "scripts/",
    "services/requirements.txt",
    "services/d1-systemone-server.py",
    "services/d1-typesafe-adapter.py",
    "docs/"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "minGatewayVersion": "2026.10.9",
      "pluginApi": ">=2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.11.3"
    }
  },
  "keywords": [
    "decision-intelligence",
    "local-llm",
    "apple-silicon",
    "mlx",
    "openclaw-plugin",
    "openclaw-decision-provider"
  ]
}
