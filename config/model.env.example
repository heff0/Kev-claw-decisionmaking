# Single source of truth for which decision model the System One runner loads.
# Copy to config/model.env (gitignored) and adjust, or use:
#   scripts/set-model.sh <huggingface-repo-id>   (downloads, swaps, restarts, verifies)
# After editing by hand: launchctl kickstart -k gui/$(id -u)/com.openclaw.d1-server
KEV_MODEL=LiquidAI/d1-Omni-2B-MLX-8bit

# Python interpreter used by the runner (mlx-vlm must be installed there).
# scripts/setup.sh and scripts/install-services.sh fill this in automatically.
KEV_PYTHON={{PYTHON}}
