# Single source of truth for which decision model the System One runner loads.
# Change with: scripts/set-model.sh <huggingface-repo-id>  (downloads, swaps, restarts, verifies)
# or edit this file by hand and: launchctl kickstart -k gui/$(id -u)/com.openclaw.d1-server
KEV_MODEL=LiquidAI/d1-Omni-2B-MLX-8bit

# Python interpreter used by the runner (mlx-vlm must be installed there).
KEV_PYTHON=/Users/remote-mac/.openclaw/workspace/mlx-env/bin/python
