<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/install-services.sh; replace {{PLACEHOLDERS}} before use. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.openclaw.typesafe-adapter</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{PYTHON}}</string>
		<string>-u</string>
		<string>{{REPO}}/services/d1-typesafe-adapter.py</string>
